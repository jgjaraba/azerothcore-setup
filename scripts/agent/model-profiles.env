# Model profiles for the private AzerothCore project.
#
# Consumed by scripts/agent/opencode-profile.sh, which injects the selected
# profile as OPENCODE_CONFIG_CONTENT so agent files need not pin a model.

# OpenCode Go profile
AC_GO_BUILD="opencode-go/kimi-k2.7-code"
AC_GO_RESEARCH="opencode-go/deepseek-v4.1-flash"
AC_GO_REVIEW="opencode-go/gpt-5.6-luna"

# OpenAI fallback profile
AC_OPENAI_BUILD="openai/gpt-5.6-terra"
AC_OPENAI_RESEARCH="openai/gpt-5.6-luna"
AC_OPENAI_REVIEW="openai/gpt-5.6-sol"
