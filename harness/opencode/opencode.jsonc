{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "ac-build",
  "share": "disabled",
  "instructions": [
    ".opencode/project-instructions.md"
  ],
  "permission": {
    "external_directory": {
      "~/azerothcore-setup/**": "allow"
    },
    "edit": {
      "*": "ask",
      "~/azerothcore-setup/**": "ask",
      "~/azerothcore-setup/docs/project/**": "allow",
      "~/azerothcore-setup/plans/**": "allow"
    },
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git rev-parse": "allow",
      "git rev-parse *": "allow",
      "~/azerothcore-setup/scripts/agent/refresh-environment.sh": "allow",
      "git push": "deny",
      "git push *": "deny",
      "git clean": "deny",
      "git clean *": "deny",
      "git reset --hard": "deny",
      "git reset --hard *": "deny"
    }
  }
}
