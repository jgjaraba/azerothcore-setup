{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "ac-build",
  "share": "disabled",
  "instructions": [
    ".opencode/project-instructions.md"
  ],
  "permission": {
    "external_directory": {
      "~/azerothcore-setup/**": "allow"
    },
    "edit": {
      "*": "ask",
      "~/azerothcore-setup/**": "ask",
      "~/azerothcore-setup/docs/project/**": "allow",
      "~/azerothcore-setup/plans/**": "allow"
    },
    "bash": {
      "*": "allow",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
