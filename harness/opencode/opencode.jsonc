{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "ac-build",
  "share": "disabled",
  "instructions": [
    ".opencode/project-instructions.md"
  ],
  "permission": {
    "external_directory": {
      "~/azerothcore-setup/**": "allow"
    },
    "edit": {
      "*": "ask",
      "~/azerothcore-setup/**": "ask",
      "~/azerothcore-setup/docs/project/**": "allow",
      "~/azerothcore-setup/plans/**": "allow"
    },
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "printf *": "allow",
      "sort": "allow",
      "sort *": "allow",
      "locale": "allow",
      "locale *": "allow",
      "wc *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "cut *": "allow",
      "uniq *": "allow",
      "comm *": "allow",
      "cmp *": "allow",
      "diff *": "allow",
      "sha256sum *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "realpath *": "allow",
      "readlink *": "allow",
      "which *": "allow",
      "command -v *": "allow",
      "test *": "allow",
      "true": "allow",
      "false": "allow",
      "mysql --version": "allow",
      "mysql -V": "allow",
      "python3 --version": "allow",
      "cmake --version": "allow",
      "make --version": "allow",
      "gcc --version": "allow",
      "g++ --version": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git rev-parse": "allow",
      "git rev-parse *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "git ls-tree *": "allow",
      "git grep *": "allow",
      "git describe *": "allow",
      "git remote -v": "allow",
      "git remote get-url *": "allow",
      "git branch": "allow",
      "git branch --show-current": "allow",
      "git branch --list": "allow",
      "git branch --list *": "allow",
      "git branch -vv": "allow",
      "git -C * status": "allow",
      "git -C * status *": "allow",
      "git -C * diff": "allow",
      "git -C * diff *": "allow",
      "git -C * log": "allow",
      "git -C * log *": "allow",
      "git -C * show": "allow",
      "git -C * show *": "allow",
      "git -C * rev-parse": "allow",
      "git -C * rev-parse *": "allow",
      "git -C * ls-files": "allow",
      "git -C * ls-files *": "allow",
      "git -C * remote -v": "allow",
      "git -C * remote get-url *": "allow",
      "/home/dev/azerothcore-setup/scripts/agent/refresh-environment.sh": "allow",
      "~/azerothcore-setup/scripts/agent/refresh-environment.sh": "allow",
      "/home/dev/azerothcore-setup/scripts/agent/validate-harness.sh": "allow",
      "~/azerothcore-setup/scripts/agent/validate-harness.sh": "allow",
      "python3 scripts/item_dbc_tool.py * --dry-run": "allow",
      "python3 /home/dev/azerothcore-setup/scripts/item_dbc_tool.py * --dry-run": "allow",
      "\"/home/dev/azerothcore-setup/scripts/agent/refresh-environment.sh\"": "allow",
      "\"/home/dev/azerothcore-setup/scripts/agent/validate-harness.sh\"": "allow",
      "python3 /home/dev/azerothcore-setup/scripts/item_dbc_tool.py --dry-run": "allow",
      "python3 /home/dev/azerothcore-setup/scripts/item_dbc_tool.py --dry-run *": "allow",
      "python3 /home/dev/azerothcore-setup/scripts/item_dbc_tool.py * --dry-run *": "allow",
      "python3 \"/home/dev/azerothcore-setup/scripts/item_dbc_tool.py\" --dry-run": "allow",
      "python3 \"/home/dev/azerothcore-setup/scripts/item_dbc_tool.py\" --dry-run *": "allow",
      "python3 \"/home/dev/azerothcore-setup/scripts/item_dbc_tool.py\" * --dry-run": "allow",
      "python3 \"/home/dev/azerothcore-setup/scripts/item_dbc_tool.py\" * --dry-run *": "allow",
      "sort -o *": "ask",
      "sort * -o *": "ask",
      "sort --output=*": "ask",
      "* > *": "ask",
      "* >> *": "ask",
      "* 1> *": "ask",
      "* 2> *": "ask",
      "git reset --hard": "deny",
      "git reset --hard *": "deny",
      "git add": "deny",
      "git add *": "deny",
      "git commit": "deny",
      "git commit *": "deny",
      "git push": "deny",
      "git push *": "deny",
      "git pull": "deny",
      "git pull *": "deny",
      "git switch": "deny",
      "git switch *": "deny",
      "git checkout": "deny",
      "git checkout *": "deny",
      "git merge": "deny",
      "git merge *": "deny",
      "git rebase": "deny",
      "git rebase *": "deny",
      "git cherry-pick": "deny",
      "git cherry-pick *": "deny",
      "git revert": "deny",
      "git revert *": "deny",
      "git restore": "deny",
      "git restore *": "deny",
      "git reset": "deny",
      "git reset *": "deny",
      "git clean": "deny",
      "git clean *": "deny",
      "git stash": "deny",
      "git stash *": "deny",
      "git branch -d *": "deny",
      "git branch -D *": "deny",
      "git branch -m *": "deny",
      "git branch -M *": "deny",
      "git tag": "deny",
      "git tag *": "deny",
      "git worktree *": "deny"
    }
  }
}
